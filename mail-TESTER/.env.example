# Mail Tester Configuration
# Copy this file to .env and adjust values as needed.
# All variables use the MAILTESTER_ prefix.

# ── Server ────────────────────────────────────────────────────────
MAILTESTER_SMTP_HOST=0.0.0.0
MAILTESTER_SMTP_PORT=2525
MAILTESTER_SMTP_DOMAIN=mail-tester.phishing.click
MAILTESTER_WEB_HOST=0.0.0.0
# Default local web port. If occupied, `make run` asks whether to use a random port.
MAILTESTER_WEB_PORT=31337

# ── Storage ───────────────────────────────────────────────────────
# MAILTESTER_DATA_DIR=./data

# ── DNS ───────────────────────────────────────────────────────────
MAILTESTER_DNS_RESOLVER=8.8.8.8
MAILTESTER_DNSBL_TIMEOUT=3.0

# ── Analysis ──────────────────────────────────────────────────────
MAILTESTER_LINK_CHECK_TIMEOUT=5.0
MAILTESTER_MAX_LINKS_TO_CHECK=20

# ── LLM Provider ─────────────────────────────────────────────────
# Options: none, ollama, openai, anthropic, malwarebytes
MAILTESTER_LLM_PROVIDER=none
MAILTESTER_LLM_MODEL=
# Maximum time for one chat answer before returning an error.
MAILTESTER_CHAT_TIMEOUT=60.0

# Ollama (local LLM)
MAILTESTER_OLLAMA_URL=http://localhost:11434

# OpenAI
MAILTESTER_OPENAI_API_KEY=

# Anthropic
MAILTESTER_ANTHROPIC_API_KEY=

# Malwarebytes Scamguard
MAILTESTER_MALWAREBYTES_API_KEY=
MAILTESTER_MALWAREBYTES_API_URL=https://api.malwarebytes.com/scamguard/v1
